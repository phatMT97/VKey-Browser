{
  "manifest_version": 3,
  "name": "VKey Browser",
  "version": "0.1.0",
  "description": "Route VKey by website: default, English, or TSF compatibility mode.",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "storage", "tabs"],
  "background": {
    "scripts": ["src/rules.js", "src/background.js"],
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "VKey Browser",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@vkey.phatmt97.github.io",
      "strict_min_version": "121.0"
    }
  }
}
